{
  "name": "@shorty/bot",
  "version": "1.0.0",
  "main": "index.ts",
  "author": "Rick Zhang <rickzhang@live.ca>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "22.17.0",
    "pnpm": "10.13.1"
  },
  "dependencies": {
    "@fightmegg/riot-api": "^0.0.21",
    "@twurple/api": "^8.0.2",
    "@twurple/api-call": "^8.0.2",
    "@twurple/auth": "^8.0.2",
    "@twurple/chat": "^8.0.2",
    "@twurple/easy-bot": "^8.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "openai": "^6.15.0",
    "temporal-polyfill": "^0.3.0"
  },
  "scripts": {
    "start": "cross-env ENVIRONMENT=prod pnpm exec tsx index.ts",
    "dev": "pnpm exec tsx index.ts",
    "test": "cross-env ENVIRONMENT=test pnpm exec vitest",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t shortybot .",
    "docker:run": "docker run --name shortybot --env-file .env shortybot"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
